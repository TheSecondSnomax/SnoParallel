t></g><g class="message" data-participant-1="variable" data-participant-2="user"><polygon fill="#E7E7E7" points="59.2681,747.0859,49.2681,751.0859,59.2681,755.0859,55.2681,751.0859" style="stroke:#E7E7E7;stroke-width:1;"/><line style="stroke:#E7E7E7;stroke-width:1;stroke-dasharray:2,2;" x1="53.2681" x2="217.916" y1="751.0859" y2="751.0859"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="76.5654" x="65.2681" y="746.02">report done</text></g></g></svg>Ù€322412f4d79e583f44b4f2ca09cd9d03bfb90d88a4839d92514a0d76ef03b665d849002981af50f13b9469d402f40775a0bf4c8fcc545955973864a0683b64b8ƒ¦schemeÚ !include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/light.puml
participant manager
participant workers
participant queue

== initialisation ==

activate manager
manager -> queue: start command
deactivate manager

activate queue
manager <-- queue: report ready
deactivate queue

activate manager
manager -> workers: start command
deactivate manager

activate workers
manager <-- workers: report ready
deactivate workers

== work cycle(s) ==

loop for all work cycles
activate manager

loop for all work items
    manager -> queue: add work item
    deactivate manager
    activate queue
end

workers <-- queue: report ready
deactivate queue

loop until empty
    activate workers
    workers -> queue: get work item
    deactivate workers
    
    activate queue
    workers <- queue: return work item
    deactivate queue
    
    activate workers
    workers -> workers: process work item

end

workers -> queue: get work item
deactivate workers

activate queue
workers <-- queue: report empty
deactivate queue

activate workers
manager <-- workers: report done
deactivate workers

activate manager
end

== termination ==

activate manager
manager -> queue: stop command
deactivate manager

activate queue
manager <-- queue: report stopped
deactivate queue

activate manager
manager -> workers: stop command
deactivate manager

activate workers
