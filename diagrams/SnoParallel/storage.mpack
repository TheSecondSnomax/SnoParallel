ill="#FF0000" points="74.2681,1258.3438,64.2681,1262.3438,74.2681,1266.3438,70.2681,1262.3438" style="stroke:#FF0000;stroke-width:1;"/><line style="stroke:#FF0000;stroke-width:1;stroke-dasharray:2,2;" x1="68.2681" x2="242.7061" y1="1262.3438" y2="1262.3438"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="145.9897" x="80.2681" y="1257.2778">report worker(s) failed</text></g><rect fill="#111111" height="3" style="stroke:#111111;stroke-width:1;" width="324.1582" x="0" y="1297.9102"/><line style="stroke:#FFFFFF;stroke-width:1;" x1="0" x2="324.1582" y1="1297.9102" y2="1297.9102"/><line style="stroke:#FFFFFF;stroke-width:1;" x1="0" x2="324.1582" y1="1300.9102" y2="1300.9102"/><rect fill="#111111" height="23.1328" style="stroke:#FFFFFF;stroke-width:2;" width="104.854" x="109.6521" y="1287.3438"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" font-weight="bold" lengthAdjust="spacing" textLength="86.3281" x="115.6521" y="1303.4106">termination</text><g class="message" data-participant-1="user" data-participant-2="manager"><polygon fill="#E7E7E7" points="226.7061,1337.6094,236.7061,1341.6094,226.7061,1345.6094,230.7061,1341.6094" style="stroke:#E7E7E7;stroke-width:1;"/><line style="stroke:#E7E7E7;stroke-width:1;" x1="58.2681" x2="232.7061" y1="1341.6094" y2="1341.6094"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="97.0938" x="65.2681" y="1336.5435">stop command</text></g><g class="message" data-participant-1="manager" data-participant-2="user"><polygon fill="#E7E7E7" points="69.2681,1366.7422,59.2681,1370.7422,69.2681,1374.7422,65.2681,1370.7422" style="stroke:#E7E7E7;stroke-width:1;"/><line style="stroke:#E7E7E7;stroke-width:1;stroke-dasharray:2,2;" x1="63.2681" x2="242.7061" y1="1370.7422" y2="1370.7422"/><text fill="#FFFFFF" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="96.7002" x="75.2681" y="1365.6763">report stopped</text></g></g></svg>Ù€958eb696307d74de80d0c91d44797e099129e4a2306c7429d1750d6bb4bbc8d89bf2a83cadff827ad09970e2b98044b2672c6f9462d9cf0a55e3781e32bc2371ƒ¦schemeÚ­!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/light.puml
actor user
participant variable
participant memory

alt read

    == during work ==

    activate user
    user -> variable: read value
    deactivate user
    
    activate variable
    variable -> memory: request old value
    deactivate variable
    
    activate memory
    variable <- memory: return old value
    deactivate memory
    
    activate variable
    user <- variable: return old value
    deactivate variable

activate user
end

alt write

    == during work ==

    activate user
    user -> variable: write value
    deactivate user
    
    activate variable
    variable -> variable: value check
    
    alt incorrect value
    user <-[#red]- variable: report incorrect value
    end
    
    alt correct value
    variable -> memory: write new value
    deactivate variable
    
    activate memory
    variable <-memory: report done
    deactivate memory
    
    activate variable
    user <-- variable: report done
    deactivate variable
    
    activate user
    end
    
    == after work ==

    user -> variable: update command
    deactivate user
    
    activate variable
    variable -> memory: write old value
    deactivate variable
    
    activate memory
    variable <-- memory: report done
    deactivate memory
    
    activate variable
    user <-- variable: report done
    deactivate variable
    
