oke-width:1;" width="324.1582" x="0" y="111.8633"/><line style="stroke:#000000;stroke-width:1;" x1="0" x2="324.1582" y1="111.8633" y2="111.8633"/><line style="stroke:#000000;stroke-width:1;" x1="0" x2="324.1582" y1="114.8633" y2="114.8633"/><rect fill="#EEEEEE" height="23.1328" style="stroke:#000000;stroke-width:2;" width="110.4146" x="106.8718" y="101.2969"/><text fill="#000000" font-family="sans-serif" font-size="13" font-weight="bold" lengthAdjust="spacing" textLength="91.8887" x="112.8718" y="117.3638">initialisation</text><g class="message" data-participant-1="user" data-participant-2="manager"><polygon fill="#181818" points="226.7061,151.5625,236.7061,155.5625,226.7061,159.5625,230.7061,155.5625" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;" x1="58.2681" x2="232.7061" y1="155.5625" y2="155.5625"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="99.2964" x="65.2681" y="150.4966">start command</text></g><g class="message" data-participant-1="manager" data-participant-2="user"><polygon fill="#181818" points="74.2681,180.6953,64.2681,184.6953,74.2681,188.6953,70.2681,184.6953" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;stroke-dasharray:2,2;" x1="68.2681" x2="242.7061" y1="184.6953" y2="184.6953"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="81.377" x="80.2681" y="179.6294">report ready</text></g><g class="message" data-participant-1="user" data-participant-2="manager"><polygon fill="#181818" points="226.7061,209.8281,236.7061,213.8281,226.7061,217.8281,230.7061,213.8281" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;" x1="58.2681" x2="232.7061" y1="213.8281" y2="213.8281"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="105.4092" x="65.2681" y="208.7622">request workers</text></g><g class="message" data-par