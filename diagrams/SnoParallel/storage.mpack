participant "worker 1" as sub_1
participant "worker 2" as sub_2
participant variable

== process work item ==

activate sub_1
activate sub_2

sub_1 -> variable: write new value
deactivate sub_1

activate variable

sub_2 -> variable: read value
deactivate sub_2

activate variable
sub_2 <-[#red]- variable: report blocked
deactivate variable

activate sub_2
sub_2 -> sub_2: wait

sub_1 <-- variable: report done
deactivate variable

activate sub_1

sub_2 -> variable: read value
deactivate sub_2

activate variable
sub_2 <- variable: return old value
deactivate variable

