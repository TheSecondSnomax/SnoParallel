" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="72.9873" x="438.23" y="222.6257">_bytes: int</text><polygon fill="none" points="429.23,230.5759,433.23,234.5759,429.23,238.5759,425.23,234.5759" style="stroke:#B38D22;stroke-width:1;"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="123.3408" x="438.23" y="238.9226">_shape: tuple[int]</text><polygon fill="none" points="429.23,246.8728,433.23,250.8728,429.23,254.8728,425.23,250.8728" style="stroke:#B38D22;stroke-width:1;"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="102.5527" x="438.23" y="255.2195">_variable: bool</text><line style="stroke:#181818;stroke-width:0.5;" x1="419.23" x2="582.7788" y1="262.5213" y2="262.5213"/><ellipse cx="429.23" cy="276.1697" fill="#84BE84" rx="3" ry="3" style="stroke:#038048;stroke-width:1;"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="42.7588" x="438.23" y="279.5164">read()</text><ellipse cx="429.23" cy="292.4666" fill="#84BE84" rx="3" ry="3" style="stroke:#038048;stroke-width:1;"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="46.1221" x="438.23" y="295.8132">write()</text><ellipse cx="429.23" cy="308.7634" fill="#84BE84" rx="3" ry="3" style="stroke:#038048;stroke-width:1;"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="60.252" x="438.23" y="312.1101">update()</text><ellipse cx="429.23" cy="325.0603" fill="#84BE84" rx="3" ry="3" style="stroke:#038048;stroke-width:1;"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="61.0654" x="438.23" y="328.407">__init__()</text></g></g></svg>Ù€1b55acd8990ac63a289ce57b44adac475b7ed907f6c2e1c00999da40068e8fe093496e93777fa779f905c7e98cb49a57e4b6563c895b69323e366b6797907cbeƒ¦schemeÚ7!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/dark.puml
package SnoParallel {

    package managers {
    
        class Manager {
            + variables: list[Variable]
            # _manager_sync: SyncManager
            # _manager_mem: SharedMemoryManager
            # _queue: Queue
            # _locks: list[Lock]
            # _variables: list[Variable]
            # _memory: list[SharedMemory]
            # _events: list[Event]
            # _workers: list[Process]
            
            + add_work()
            + wait()
            + request_variable()
            + request_workers()
            + __init__()
            + __del__()
        }
    
    }
    
    package variables {
    
        class Variable {
            # _memory: str
            # _lock: Lock
            # _type: VariableType
            # _bytes: int
            # _shape: tuple[int]
            # _variable: bool
            
            + read()
            + write()
            + update()
            + __init__()
        }
    
    }

