participant "worker 1" as sub_1
participant "worker 2" as sub_2
participant variable

== process work item ==

activate sub_1
activate sub_2

sub_1 -> variable: write new value
deactivate sub_1

activate variable

sub_2 -> variable: read value
deactivate sub_2

activate variable
sub_2 <-[#red]- variable: report blocked
deactivate variable

activate sub_2
sub_2 -> sub_2: wait

sub_1 <-- variable: report done
deactivate variable

activate sub_1

sub_2 -> variable: read value
deactivate sub_2

activate variable
sub_2 <- variable: return old value
deactivate variable

activate sub_2¤mode¤dark§diagramÚ&<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" contentStyleType="text/css" data-diagram-type="SEQUENCE" height="351px" preserveAspectRatio="xMidYMid meet" style="width:308px;height:351px;background:#1B1B1B;" version="1.1" viewBox="0 0 308 351" width="308px" zoomAndPan="magnify" class="diagram"><defs/><g><rect fill="#1B1B1B" height="351" style="stroke:none;stroke-width:1;" width="308" x="0" y="0"/><g><title>worker 1</title><rect fill="#313139" height="64.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="37.8027" y="46.2969"/></g><g><title>worker 1</title><rect fill="#313139" height="67.2656" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="37.8027" y="240.0938"/></g><g><title>worker 2</title><rect fill="#313139" height="93.3984" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="123.4082" y="46.2969"/></g><g><title>worker 2</title><rect fill="#313139" height="100.3984" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="123.4082" y="168.8281"/></g><g><title>worker 2</title><rect fill="#313139" height="9" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="123.4082" y="298.3594"/></g><g><title>variable</title><rect fill="#313139" height="129.5313" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="256.2622" y="110.5625"/></g><g><title>variable</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="261.2622" y="139.6953"/></g><g><title>variable</title><rect fill="#313139" height="29.1328" style="stroke:#E7E7E7;stroke-width:1;" width="10" x="256.2622" y="269.2266"/></g><g><title>worker 1</title><rect fill="#000000" fill-opacity="0.00000" height="280.0625" width="8" x="38.8027" y="36.2969"/><line style="stroke:#E7E7E7;stroke-width:0.5;stroke-dasharray:5,5;" x1="42" x2="42" y1="36.2969" y2="316.3594"/></g><g><title>worker 2</title><rect fill="#000000" fill-opacity="0.00000" height="280.0625" width="8" x="124.4082" y="36.2969"/><line style="s