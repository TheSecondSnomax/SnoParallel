participant manager
participant workers
participant queue

== initialisation ==

activate manager
manager -> queue: start command
deactivate manager

activate queue
manager <-- queue: report ready
deactivate queue

activate manager
manager -> workers: start command
deactivate manager

activate workers
manager <-- workers: report ready
deactivate workers

== work cycle(s) ==

loop for all work cycles
activate manager

loop for all work items
    manager -> queue: add work item
    deactivate manager
    activate queue
end

workers <-- queue: report ready
deactivate queue

loop until empty
    activate workers
    workers -> queue: get work item
    deactivate workers
    
    activate queue
    workers <- queue: return work item
    deactivate queue
    
    activate workers
    workers -> workers: process work item

end

workers -> queue: get work item
deactivate workers

activate queue
workers <-- queue: report empty
deactivate queue

activate workers
manager <-- workers: report done
deactivate workers

activate manager
end

== termination ==

activate manager
manager -> queue: stop command
deactivate manager

activate queue
manager <-- queue: report stopped
deactivate queue

activate manager
manager -> workers: stop command
deactivate manager

activate workers
manager <-- workers: report stopped
