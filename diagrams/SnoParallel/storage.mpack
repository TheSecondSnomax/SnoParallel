line style="stroke:#000000;stroke-width:1;" x1="0" x2="427.4565" y1="619.9883" y2="619.9883"/><line style="stroke:#000000;stroke-width:1;" x1="0" x2="427.4565" y1="622.9883" y2="622.9883"/><rect fill="#EEEEEE" height="23.1328" style="stroke:#000000;stroke-width:2;" width="94.9199" x="166.2683" y="609.4219"/><text fill="#000000" font-family="sans-serif" font-size="13" font-weight="bold" lengthAdjust="spacing" textLength="76.394" x="172.2683" y="625.4888">after work</text><g class="message" data-participant-1="user" data-participant-2="variable"><polygon fill="#181818" points="201.916,659.6875,211.916,663.6875,201.916,667.6875,205.916,663.6875" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;" x1="48.2681" x2="207.916" y1="663.6875" y2="663.6875"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="114.8228" x="55.2681" y="658.6216">update command</text></g><g class="message" data-participant-1="variable" data-participant-2="memory"><polygon fill="#181818" points="344.209,688.8203,354.209,692.8203,344.209,696.8203,348.209,692.8203" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;" x1="218.916" x2="350.209" y1="692.8203" y2="692.8203"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="96.2749" x="225.916" y="687.7544">write old value</text></g><g class="message" data-participant-1="memory" data-participant-2="variable"><polygon fill="#181818" points="234.916,717.9531,224.916,721.9531,234.916,725.9531,230.916,721.9531" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;stroke-dasharray:2,2;" x1="228.916" x2="360.209" y1="721.9531" y2="721.9531"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="76.5654" x="240.916" y="716.8872">report done</text></g><g class="message" data-participant-1="variable" data-participant-2="user"><polygon fill="#181818" points="59.2681,747.0859,49.2681,751.0859,59.2681,755.0859,55.2681,751.0859" style="stroke:#181818;stroke-width:1;"/><line style="stroke:#181818;stroke-width:1;stroke-dasharray:2,2;" x1="53.2681" x2="217.916" y1="751.0859" y2="751.0859"/><text fill="#000000" font-family="sans-serif" font-size="13" lengthAdjust="spacing" textLength="76.5654" x="65.2681" y="746.02">report done</text></g></g></svg>Ù€517c5027a34d3d5bf6386ccf706df2af49320d8ae63600e13100c7c7710f7c6e35acc176e9c9ef182525962622d392af594b2a2e0f94f9f692e6e2464b7cf9d5ƒ¦schemeÚ¬!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/dark.puml
actor user
participant variable
participant memory

alt read

    == during work ==

    activate user
    user -> variable: read value
    deactivate user
    
    activate variable
    variable -> memory: request old value
    deactivate variable
    
    activate memory
    variable <- memory: return old value
    deactivate memory
    
    activate variable
    user <- variable: return old value
    deactivate variable

activate user
end

alt write

    == during work ==

    activate user
    user -> variable: write value
    deactivate user
    
    activate variable
    variable -> variable: value check
    
    alt incorrect value
    user <-[#red]- variable: report incorrect value
    end
    
    alt correct value
    variable -> memory: write new value
    deactivate variable
    
    activate memory
    variable <-memory: report done
    deactivate memory
    
    activate variable
    user <-- variable: report done
    deactivate variable
    
    activate user
    end
    
    == after work ==

    user -> variable: update command
    deactivate user
    
    activate variable
    variable -> memory: write old value
    deactivate variable
    
    activate memory
    variable <-- memory: report done
    deactivate memory
    
    activate variable
    user <-- variable: report done
    deactivate variable
    
