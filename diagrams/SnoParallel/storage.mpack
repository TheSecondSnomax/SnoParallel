participant manager
participant memory
participant variable

== initialisation ==

activate manager
manager -> memory: allocate memory
deactivate manager

activate memory
manager <- memory: return reference
deactivate memory

activate manager
manager -> variable: start command
deactivate manager

activate variable
memory <- variable: write initial value
deactivate variable

activate memory
memory --> variable: report done
deactivate memory

activate variable
manager <-- variable: report ready
deactivate variable

== termination ==

activate manager
manager -> memory: deallocate memory
deactivate manager

activate memory
manager <-- memory: report done
