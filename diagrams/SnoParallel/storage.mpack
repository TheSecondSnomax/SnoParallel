8384948a32e7e60d1f1f38c170b98137559e9ce0aaƒ¦schemeÚ
>!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/dark.puml
actor user
participant manager

== initialisation ==

activate user
user -> manager: start command
deactivate user

activate manager
user <-- manager: report ready
deactivate manager

activate user
user -> manager: request workers
deactivate user

activate manager
user <- manager: report ready
deactivate manager

activate user
loop for all shared variables

    user -> manager: request shared variable
    deactivate user
    
    activate manager
    user <- manager: return shared variable
    deactivate manager
    
activate user
end

== work cycle(s) ==

alt single work cycle

    loop for all work items
    
        user -> manager: add work item
        deactivate user
        
        activate manager
        user <-- manager: report added
        deactivate manager
        activate user
    
    end

    user -> manager: request status*
    deactivate user
    
    activate manager
    user <-- manager: report status
    deactivate manager

activate user
end

alt multiple sequential work cycles

    loop for all work cycles
    
        loop for all work items
    
            user -> manager: add work items
            deactivate user
            
            activate manager
            user <-- manager: report added
            deactivate manager
            activate user
        
        end

        user -> manager: request status*
        deactivate user
        
        activate manager
        user <-- manager: report status
        deactivate manager
    
    activate user
    end

end

alt multiple independent work cycles

    loop for all work cycles
        
        loop for all work items
    
            user -> manager: add work items
            deactivate user
            
            activate manager
            user <-- manager: report added
            deactivate manager
        
        end
    
    activate user
    end

    user -> manager: request status*
    deactivate user
    
    activate manager
    user <-- manager: report status
    deactivate manager

activate user
end

== request status* ==

user -> manager: request status
deactivate user

activate manager
manager -> manager: wait

alt finished
    user <-- manager: report done
end

alt timeout
    user <-[#red]- manager: report work not finished
end

alt failed
    user <-[#red]- manager: report worker(s) failed
    deactivate manager

activate user
end

== termination ==

user -> manager: stop command
deactivate user

activate manager
user <-- manager: report stopped
