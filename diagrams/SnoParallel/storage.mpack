ŒÙ€3b5bca80001974fab1b3acc0056de6ae9eddeaee5e2dbca3a0e077eab325c23d915a81cfb745d08a0216d00ee86f0f4a800003adfbb9bfc4d620361049db414cƒ¦schemeÚ
?!include https://raw.githubusercontent.com/MikhailKravets/mkdocs_puml/master/themes/default/light.puml
actor user
participant manager

== initialisation ==

activate user
user -> manager: start command
deactivate user

activate manager
user <-- manager: report ready
deactivate manager

activate user
user -> manager: request workers
deactivate user

activate manager
user <- manager: report ready
deactivate manager

activate user
loop for all shared variables

    user -> manager: request shared variable
    deactivate user
    
    activate manager
    user <- manager: return shared variable
    deactivate manager
    
activate user
end

== work cycle(s) ==

alt single work cycle

    loop for all work items
    
        user -> manager: add work item
        deactivate user
        
        activate manager
        user <-- manager: report added
        deactivate manager
        activate user
    
    end

    user -> manager: request status*
    deactivate user
    
    activate manager
    user <-- manager: report status
    deactivate manager

activate user
end

alt multiple sequential work cycles

    loop for all work cycles
    
        loop for all work items
    
            user -> manager: add work items
            deactivate user
            
            activate manager
            user <-- manager: report added
            deactivate manager
            activate user
        
        end

        user -> manager: request status*
        deactivate user
        
        activate manager
        user <-- manager: report status
        deactivate manager
    
    activate user
    end

end

alt multiple independent work cycles

    loop for all work cycles
        
        loop for all work items
    
            user -> manager: add work items
            deactivate user
            
            activate manager
            user <-- manager: report added
            deactivate manager
        
        end
    
    activate user
    end

    user -> manager: request status*
    deactivate user
    
    activate manager
    user <-- manager: report status
    deactivate manager

activate user
end

== request status* ==

user -> manager: request status
deactivate user

activate manager
manager -> manager: wait

alt finished
    user <-- manager: report done
end

alt timeout
    user <-[#red]- manager: report work not finished
end

alt failed
    user <-[#red]- manager: report worker(s) failed
    deactivate manager

activate user
end

== termination ==

user -> manager: stop command
deactivate user

activate manager
user <-- manager: report stopped
