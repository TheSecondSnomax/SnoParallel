ht.puml
package SnoParallel {

    package managers {
    
        class Manager {
            + variables: list[Variable]
            # _manager_sync: SyncManager
            # _manager_mem: SharedMemoryManager
            # _queue: Queue
            # _locks: list[Lock]
            # _variables: list[Variable]
            # _memory: list[SharedMemory]
            # _events: list[Event]
            # _workers: list[Process]
            
            + add_work()
            + wait()
            + request_variable()
            + request_workers()
            + __init__()
            + __del__()
        }
    
    }
    
    package variables {
    
        class Variable {
            # _memory: str
            # _lock: Lock
            # _type: VariableType
            # _bytes: int
            # _shape: tuple[int]
            # _variable: bool
            
            + read()
            + write()
            + update()
            + __init__()
        }
    
    }

